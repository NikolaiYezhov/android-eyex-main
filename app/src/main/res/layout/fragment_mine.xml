<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_profile" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="EyeX"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#F5F5F5"
            android:text="去登录"
            android:textColor="#000000"
            android:textSize="14sp"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#222222"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/btnGuide" android:layout_width="match_parent" android:layout_height="65dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="新手引导" android:textColor="#FFFFFF" android:textSize="16sp" app:drawableStartCompat="@android:drawable/ic_menu_send" android:drawablePadding="16dp" app:drawableEndCompat="@android:drawable/arrow_up_float" android:background="?attr/selectableItemBackground" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginHorizontal="20dp"/>

            <TextView android:id="@+id/btnBgPermission" android:layout_width="match_parent" android:layout_height="65dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="后台权限设置" android:textColor="#FFFFFF" android:textSize="16sp" app:drawableStartCompat="@android:drawable/ic_lock_lock" android:drawablePadding="16dp" app:drawableEndCompat="@android:drawable/arrow_up_float" android:background="?attr/selectableItemBackground" />

            <View android:layout_width="match_parent" android:layout_height="20dp" android:background="#121212" />

            <TextView android:id="@+id/btnFaq" android:layout_width="match_parent" android:layout_height="65dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="常见问题" android:textColor="#FFFFFF" android:textSize="16sp" app:drawableStartCompat="@android:drawable/ic_menu_help" android:drawablePadding="16dp" app:drawableEndCompat="@android:drawable/arrow_up_float" android:background="?attr/selectableItemBackground" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginHorizontal="20dp"/>

            <TextView android:id="@+id/btnAppAbout" android:layout_width="match_parent" android:layout_height="65dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:text="关于" android:textColor="#FFFFFF" android:textSize="16sp" app:drawableStartCompat="@android:drawable/ic_menu_info_details" android:drawablePadding="16dp" app:drawableEndCompat="@android:drawable/arrow_up_float" android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>