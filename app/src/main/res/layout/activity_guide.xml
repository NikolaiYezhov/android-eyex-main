<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151515"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <Button android:id="@+id/btnSkip" android:layout_width="wrap_content" android:layout_height="40dp" android:text="跳过" android:backgroundTint="#333333" android:textColor="#FFFFFF" app:cornerRadius="20dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:layout_marginTop="10dp" android:text="1/10" android:textColor="#FFFFFF" android:textSize="16sp" />
    <ImageView android:id="@+id/btnCloseGuide" android:layout_width="40dp" android:layout_height="40dp" android:layout_alignParentEnd="true" android:background="@drawable/ic_launcher_background" android:backgroundTint="#333333" android:padding="10dp" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="#FFFFFF" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="250dp" android:layout_height="200dp" android:src="@android:drawable/ic_menu_camera" app:tint="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:text="拍摄照片" android:textColor="#AAAAAA" android:textSize="16sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="单击右前按键" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="拍照时，眼镜前侧会闪烁白色指示灯" android:textColor="#888888" android:textSize="14sp" />
    </LinearLayout>

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginBottom="20dp">
        <ImageView android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/ic_launcher_background" android:backgroundTint="#333333" android:padding="12dp" android:src="@android:drawable/ic_media_previous" app:tint="#666666" />
        <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_alignParentEnd="true" android:background="@drawable/ic_launcher_background" android:backgroundTint="#FFFFFF" android:padding="12dp" android:src="@android:drawable/ic_media_next" app:tint="#000000" />
    </RelativeLayout>
</RelativeLayout>