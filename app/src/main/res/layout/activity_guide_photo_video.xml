<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F1014" android:orientation="vertical" android:fitsSystemWindows="true">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:padding="8dp" android:src="@android:drawable/ic_menu_revert" app:tint="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Guide" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    </RelativeLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="30dp">
        <TextView android:id="@+id/tvStepNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="14sp" />
        <TextView android:id="@+id/tvGuideTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvGuideSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#AAAAAA" android:textSize="18sp" />
        <TextView android:id="@+id/tvGuideDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#888888" android:textSize="14sp" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center" android:orientation="horizontal" android:padding="16dp">
        <TextView android:id="@+id/btnSkip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="Skip" android:textColor="#666666" android:textSize="14sp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/btnNext" android:layout_width="120dp" android:layout_height="44dp" android:backgroundTint="#F5F5F5" android:text="Next" android:textColor="#000000" android:textSize="15sp" app:cornerRadius="22dp" />
    </LinearLayout>
</LinearLayout>
