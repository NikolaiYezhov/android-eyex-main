<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="#171A1F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSync"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="同步眼镜照片"
            android:backgroundTint="#007AFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最新照片预览："
            android:textColor="#888888"
            android:layout_marginTop="20dp" />

            <RadioGroup
                android:id="@+id/rgFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全部"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:checked="true"
                    android:layout_marginEnd="16dp" />

                <RadioButton
                    android:id="@+id/rbPhotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="照片"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp" />

                <RadioButton
                    android:id="@+id/rbVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    />

                <RadioButton android:id="@+id/rbAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录音"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RadioGroup>


            <androidx.recyclerview.widget.RecyclerView
                android:layoutDirection="ltr"
                android:id="@+id/rvAlbum"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:padding="4dp" />
    </LinearLayout>


    <FrameLayout
        android:id="@+id/flFullScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageView
            android:id="@+id/ivBigPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <VideoView
            android:id="@+id/vvBigVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginBottom="90dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llAudioPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="90dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_audio_record"
                app:tint="#FF9800" />
            <TextView
            android:id="@+id/tvAudioName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="正在播放录音..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
        </LinearLayout>


        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="20dp"
            android:background="#80000000">

            <Button
                android:id="@+id/btnSavePhoto"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="⬇️ 保存本机"
                android:textColor="#FFFFFF"
                android:backgroundTint="#007AFF"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnDeletePhoto"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="🗑️ 删除文件"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF3B30"/>
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>