<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171A1F"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F1014">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="选择游戏"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero 卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                app:cardBackgroundColor="#1A345A"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAME ASSIST"
                        android:textColor="#C7FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="选择一个游戏场景"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 台球辅助卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnBilliards"
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#21242B"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">
                    <View
                        android:id="@+id/accentCircle"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/ic_launcher_background"
                        android:backgroundTint="#2E78C7" />
                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_alignStart="@id/accentCircle"
                        android:layout_alignTop="@id/accentCircle"
                        android:gravity="center"
                        android:text="8"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/ic_launcher_background"
                        android:backgroundTint="#293A5C"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="已接入"
                        android:textColor="#E6F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/gameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/accentCircle"
                        android:layout_toStartOf="@id/badge"
                        android:text="台球辅助"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/gameDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/gameTitle"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_toEndOf="@id/accentCircle"
                        android:maxLines="2"
                        android:text="发一张球桌照片，获取推荐击球球、目标袋口和风险提示"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- 人脸识别卡片 (per iOS Assist) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnFaceRecognition"
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#21242B"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/faceCircle"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="F"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:background="#7B2E8E" />
                    <TextView
                        android:id="@+id/faceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/ic_launcher_background"
                        android:backgroundTint="#3A1A4A"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="已接入"
                        android:textColor="#E6F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/faceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/faceCircle"
                        android:layout_toStartOf="@id/faceBadge"
                        android:text="人脸识别"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/faceDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/faceTitle"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_toEndOf="@id/faceCircle"
                        android:maxLines="2"
                        android:text="通过眼镜拍照调用公网人脸识别接口测试"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
