<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0F1014" android:orientation="vertical">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_centerVertical="true" android:gravity="center"
            android:text="Back" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_centerInParent="true" android:text="AI Favorites"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    </RelativeLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="No favorites yet" android:textColor="#888888"
        android:textSize="16sp" android:gravity="center" />
    <Button android:id="@+id/btnShareAll" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_margin="20dp"
        android:backgroundTint="#007AFF" android:text="Share All"
        android:textColor="#FFFFFF" android:textSize="14sp" app:cornerRadius="24dp" />
</LinearLayout>
